---
const pathname = Astro.url.pathname;
---

<aside
	id="menu"
	aria-hidden="true"
	class="hidden w-full lg:w-md fixed lg:sticky top-0 left-0 h-screen lg:flex flex-col gap-8 bg-ink-black text-ghost-white border-r border-indigo-ink z-1"
>
	<div class="w-full py-4 px-8">
		<p class="text-2xl font-bold">Seth's Dashboard</p>
	</div>
	<nav class="w-full">
		<ul class="w-full flex flex-col">
			<li
				class=`flex justify-start items-center ${pathname == "/admin" ? "bg-ghost-white text-indigo-ink hover:bg-ink-black hover:text-ghost-white" : "hover:bg-ghost-white hover:text-indigo-ink"} transition`
			>
				<a class="w-full px-8 py-4" href="/admin">Dashboard</a>
			</li>
			<li
				class=`flex justify-start items-center ${pathname == "/admin/posts" ? "bg-ghost-white text-indigo-ink hover:bg-ink-black hover:text-ghost-white" : "hover:bg-ghost-white hover:text-indigo-ink"} transition`
			>
				<a class="w-full px-8 py-4" href="/admin/posts">Posts</a>
			</li>
			<li
				class=`flex justify-start items-center ${pathname == "/admin/projects" ? "bg-ghost-white text-indigo-ink hover:bg-ink-black hover:text-ghost-white" : "hover:bg-ghost-white hover:text-indigo-ink"} transition`
			>
				<a class="w-full px-8 py-4" href="/admin/projects">Projects</a>
			</li>
			<li
				class=`flex justify-start items-center ${pathname == "/admin/contacts" ? "bg-ghost-white text-indigo-ink hover:bg-ink-black hover:text-ghost-white" : "hover:bg-ghost-white hover:text-indigo-ink"} transition`
			>
				<a class="w-full px-8 py-4" href="/admin/contacts">Contacts</a>
			</li>
			<li
				class=`flex justify-start items-center ${pathname == "/admin/visitors" ? "bg-ghost-white text-indigo-ink hover:bg-ink-black hover:text-ghost-white" : "hover:bg-ghost-white hover:text-indigo-ink"} transition`
			>
				<a class="w-full px-8 py-4" href="/admin/visitors">Visitors</a>
			</li>
		</ul>
	</nav>
	<div
		class="px-8 py-4 w-full flex items-center mt-auto border-t border-ghost-white"
	>
		<div class="overflow-hidden rounded-full">
			<img src="" alt="" />
		</div>
		<div>
			<p>Sergio Gutierrez</p>
		</div>
		<div class="ml-auto">
			<button
				id="signOut"
				class="size-10 group hover:bg-ghost-white p-2 rounded-full transition"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"
					><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
					<path
						fill="rgb(245, 245, 255)"
						class="group-hover:fill-indigo-ink transition"
						d="M224 160C241.7 160 256 145.7 256 128C256 110.3 241.7 96 224 96L160 96C107 96 64 139 64 192L64 448C64 501 107 544 160 544L224 544C241.7 544 256 529.7 256 512C256 494.3 241.7 480 224 480L160 480C142.3 480 128 465.7 128 448L128 192C128 174.3 142.3 160 160 160L224 160zM566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L438.6 169.3C426.1 156.8 405.8 156.8 393.3 169.3C380.8 181.8 380.8 202.1 393.3 214.6L466.7 288L256 288C238.3 288 224 302.3 224 320C224 337.7 238.3 352 256 352L466.7 352L393.3 425.4C380.8 437.9 380.8 458.2 393.3 470.7C405.8 483.2 426.1 483.2 438.6 470.7L566.6 342.7z"
					></path></svg
				>
			</button>
		</div>
	</div>
</aside>
<button id="menuToggle" class="lg:hidden fixed top-4 right-8 size-8 z-2">
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"
		><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
		<path
			class="fill-indigo-ink transition"
			d="M96 160C96 142.3 110.3 128 128 128L512 128C529.7 128 544 142.3 544 160C544 177.7 529.7 192 512 192L128 192C110.3 192 96 177.7 96 160zM96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320zM544 480C544 497.7 529.7 512 512 512L128 512C110.3 512 96 497.7 96 480C96 462.3 110.3 448 128 448L512 448C529.7 448 544 462.3 544 480z"
		></path>
		<path
			class="fill-ghost-white opacity-0 transition"
			d="M504.6 148.5C515.9 134.9 514.1 114.7 500.5 103.4C486.9 92.1 466.7 93.9 455.4 107.5L320 270L184.6 107.5C173.3 93.9 153.1 92.1 139.5 103.4C125.9 114.7 124.1 134.9 135.4 148.5L278.3 320L135.4 491.5C124.1 505.1 125.9 525.3 139.5 536.6C153.1 547.9 173.3 546.1 184.6 532.5L320 370L455.4 532.5C466.7 546.1 486.9 547.9 500.5 536.6C514.1 525.3 515.9 505.1 504.6 491.5L361.7 320L504.6 148.5z"
		></path>
	</svg>
</button>

<script>
	import { createLayout, type DOMTargetSelector } from "animejs";
	import { logout } from "../../db/Auth";

	const menu = document.getElementById("menu");
	const menuToggle = document.getElementById("menuToggle");
	const signOut = document.getElementById("signOut");

	const layout = createLayout(menu as DOMTargetSelector, {
		leaveTo: {
			opacity: "0",
		},
	});

	const animationMenu = () => {
		layout.update(({ root }) => {
			if (menu?.ariaHidden === "true") {
				menu?.classList.replace("hidden", "flex");
				menuToggle?.children[0].children[0].classList.toggle(
					"opacity-0",
				);
				menuToggle?.children[0].children[1].classList.toggle(
					"opacity-100",
				);
				menu.ariaHidden = "false";
			} else {
				menu?.classList.replace("flex", "hidden");
				menuToggle?.children[0].children[1].classList.toggle(
					"opacity-100",
				);
				menuToggle?.children[0].children[0].classList.toggle(
					"opacity-0",
				);
				menu.ariaHidden = "true";
			}
		});
	};

	menuToggle?.addEventListener("click", animationMenu);
	signOut?.addEventListener("click", async (e) => {
		e.preventDefault();

		try {
			const req = await logout();

			if (!req.success) {
				console.error(req.message);
			}

			window.posthog?.capture("admin_signed_out");
			window.posthog?.reset();
		} catch (err) {
			window.posthog?.captureException(err);
		}

		window.location.replace("/it-is-me-seth");
	});
</script>
