<script>
	const deleteBtns = document.querySelectorAll("[data-delete]");

	deleteBtns.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			window.dispatchEvent(
				new CustomEvent("modal:show", { detail: e.currentTarget.dataset.delete }),
			);
		});
	});

	window.addEventListener("modal:continue", async (e) => {
		if (e?.detail) {
			try {
				const req = await fetch(`/api/posts/${e.detail}`, {
					method: "DELETE",
					headers: {
						"Content-Type": "application/json"
					}
				});

				const data = await req.json();

				if (!data.success) {
					console.error(data.message);
					return;
				}

				window.location.reload();
			} catch (error) {
				
			}
		}
	})
</script>