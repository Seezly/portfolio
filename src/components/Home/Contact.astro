	<div class="w-full lg:w-1/2 flex flex-col gap-8">
		<form id="contactForm" class="flex flex-col gap-4">
			<label for="name">
				<span>Name</span>
				<input
					type="text"
					name="name"
					id="name"
					placeholder="Your name here"
					class="w-full py-2 px-4 bg-transparent border border-ghost-white hover:border-ghost-white/80 text-ghost-white focus:outline-none focus:ring-1 focus:ring-ghost-white focus:border-transparent transition shadow-[4px_4px_0_0] shadow-ghost-white"
				/>
			</label>
			<label for="email">
				<span>Email</span>
				<input
					type="email"
					name="email"
					id="email"
					placeholder="Your email here"
					class="w-full py-2 px-4 bg-transparent border border-ghost-white hover:border-ghost-white/80 text-ghost-white focus:outline-none focus:ring-1 focus:ring-ghost-white focus:border-transparent transition shadow-[4px_4px_0_0] shadow-ghost-white"
				/>
			</label>
			<label for="message">
				<span>Tell me about your project</span>
				<textarea
					name="message"
					id="message"
					placeholder="Your message here"
					class="w-full py-2 px-4 bg-transparent border border-ghost-white hover:border-ghost-white/80 text-ghost-white focus:outline-none focus:ring-1 focus:ring-ghost-white focus:border-transparent transition shadow-[4px_4px_0_0] shadow-ghost-white"
				></textarea>
			</label>
			<button type="submit" class="relative cursor-pointer group">
				<div
					class="py-4 px-8 text-indigo-ink bg-ghost-white uppercase border border-ghost-white w-full h-full relative z-1 group-hover:text-ghost-white group-hover:bg-indigo-ink transition"
				>
					Start a conversation
				</div>
				<div
					class="w-full h-full bg-indigo-ink absolute top-1 -right-1 border border-ghost-white group-hover:bg-ghost-white transition"
				>
				</div>
			</button>
		</form>
	</div>
</section>

<script>
	import { waapi, onScroll, stagger, splitText } from "animejs";

	const { chars } = splitText("#contact h2", { words: false, chars: true });

	const title = waapi.animate(chars, {
		transform: ["translateY(105%)", "translateY(0%)"],
		duration: 1000,
		delay: stagger(20),
		autoplay: onScroll({
			container: "body",
			target: "#contact",
		}),
	});

	const subtitle = waapi.animate("h2 + p", {
		transform: ["scale(0.95)", "scale(1)"],
		opacity: [0, 1],
		duration: 1000,
		delay: 500,
		autoplay: onScroll({
			container: "body",
			target: "#contact",
		}),
	});

	const icons = waapi.animate("#contactIcons a", {
		translateY: ["100%", "0%"],
		opacity: ["0", "1"],
		duration: 1000,
		delay: stagger(200),
		autoplay: onScroll({
			container: "body",
			target: "#contact",
		}),
	});

	const contact = waapi.animate(
		["#contactForm label", "#contactForm button"],
		{
			translateX: ["-25%", "0%"],
			opacity: ["0", "1"],
			duration: 1000,
			delay: stagger(100),
			autoplay: onScroll({
				container: "body",
				target: "#contact",
			}),
		},
	);

	const contactForm = document.getElementById(
		"contactForm",
	) as HTMLFormElement;
	const contactIcons = document.querySelectorAll("#contactIcons a");

	contactForm?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const submitBtn = contactForm.querySelector("button[type='submit']");

		const formData = new FormData(contactForm);
		formData.append("access_key", "0272966b-6205-4597-ac99-26274e1f3780");

		const originalText = submitBtn.textContent;

		submitBtn.textContent = "Sending...";
		submitBtn.disabled = true;

		try {
			window.posthog?.capture("contact_form_submitted");

			const response = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				body: formData,
			});

			const data = await response.json();

			if (response.ok) {
				try {
					const dbResponse = await fetch("/api/contacts", {
						method: "POST",
						body: JSON.stringify({
							name: formData.get("name"),
							email: formData.get("email"),
							message: formData.get("message"),
							referrer: document.referrer || "Direct",
						}),
						headers: { "Content-Type": "application/json" },
					});

					if (!dbResponse.ok) {
						console.warn("Email sent, but failed to save on DB");
						window.posthog?.capture("contact_db_save_failure");
					}
				} catch (error) {
					console.error(
						`Houston, we have a problem: ${error}. What should we do now?`,
					);
					window.posthog?.captureException(error);
				}

				alert("Success! Your message has been sent.");
				contactForm.reset();
				window.posthog?.capture("contact_form_sent_success");
			} else {
				alert("Error: " + data.message);
				window.posthog?.capture("contact_form_sent_failure", {
					error_message: data.message,
				});
			}
		} catch (error) {
			alert("Something went wrong. Please try again.");
			window.posthog?.captureException(error);
		} finally {
			submitBtn.textContent = originalText;
			submitBtn.disabled = false;
		}
	});

	contactIcons.forEach((icon) => {
		icon.addEventListener("click", () => {
			const sm = icon.getAttribute("aria-label") || "unknown";
			try {
				window.posthog?.capture("contact_social_clicked", {
					social_media: sm,
					location: "contact_section",
				});
			} catch (err) {
				window.posthog?.captureException(err);
			}
		});
	});
</script>
