---
import Image from "astro/components/Image.astro";
import pic from "../../assets/pic.png";
---

<section
	id="about"
	class="w-full flex flex-col items-center bg-ghost-white justify-between"
>
	<div
		class="w-full flex flex-col-reverse lg:flex-row justify-center items-center gap-8 py-4 px-8"
	>
		<div id="photo" class="w-full lg:w-1/2 relative">
			<div
				id="white-square"
				class="size-24 lg:size-32 bg-ghost-white border border-indigo-ink"
			>
			</div>
			<div
				id="image-square"
				class="size-96 lg:size-128 transform translate-x-12 -translate-y-12 lg:translate-x-16 lg:-translate-y-16"
			>
				<Image
					alt="some alt text"
					src={pic}
					class="w-full h-full object-cover block"
				/>
			</div>
			<div
				id="purple-square"
				class="size-24 lg:size-32 bg-indigo-ink -translate-y-24 translate-x-96 lg:translate-x-128 lg:-translate-y-32"
			>
			</div>
		</div>
		<div id="bio" class="w-full lg:w-1/2 flex flex-col gap-8">
			<div class="flex flex-col gap-4">
				<h2 class="text-8xl font-bold overflow-hidden">
					About <span class="text-indigo-ink text-bold">Me</span>
				</h2>
				<div class="flex flex-col gap-2 overflow-hidden">
					<p>
						I'm Sergio, a Computer Engineering student and
						independent web developer from Venezuela.
					</p>
					<p>
						Since 2023, I've been building websites and web
						applications for personal projects, clients and
						organizations, focusing on creating fast, accessible and
						maintainable digital experiences.
					</p>
					<p>
						I enjoy turning ideas into practical solutions, learning
						new technologies and solving real-world problems through
						software. Currently, I'm completing my degree while
						continuing to grow as a full-stack developer.
					</p>
				</div>
			</div>
			<div class="flex flex-col gap-4">
				<h3 class="text-4xl font-bold overflow-hidden pb-1">
					Currently Working <span class="text-indigo-ink text-bold"
						>With</span
					>
				</h3>
				<div id="icons" class="flex gap-4 overflow-hidden">
