</section>

<script>
	import { waapi, onScroll, stagger, splitText } from "animejs";

	const title = splitText("#about h2", { words: false, chars: true });
	const subtitle = splitText("#about h3", { words: false, chars: true });

	const whiteSquare = waapi.animate("#white-square", {
		transform: [
			"scale(1) translate(-100%, 0)",
			"scale(1.01) translate(10%, 0)",
			"scale(1) translate(0, 0)",
		],
		opacity: [0, 0.5, 1],
		duration: 1500,
		autoplay: onScroll({
			container: "body",
			target: "#photo",
		}),
	});

	const imageSquare = waapi.animate("#image-square", {
		transform: ["scale(.1)", "scale(1.01)", "scale(1)"],
		opacity: [0, 0.5, 1],
		duration: 1000,
		delay: 500,
		autoplay: onScroll({
			container: "body",
			target: "#photo",
		}),
	});

	const purpleSquare = waapi.animate("#purple-square", {
		transform: ["scale(.1)", "scale(1.01)", "scale(1)"],
		opacity: [0, 0.5, 1],
		duration: 1250,
		delay: 250,
		autoplay: onScroll({
			container: "body",
			target: "#photo",
		}),
	});

	const titleAnime = waapi.animate(title.chars, {
		transform: ["translateY(100%)", "translateY(0%)"],
		duration: 1000,
		delay: stagger(50),
		autoplay: onScroll({
			container: "body",
			target: "#bio",
		}),
	});

	const subtitleAnime = waapi.animate(subtitle.chars, {
		transform: ["translateY(100%)", "translateY(0%)"],
		duration: 1000,
		delay: stagger(20),
		autoplay: onScroll({
			container: "body",
			target: "#bio",
		}),
	});

	const paragraphs = waapi.animate("#bio p", {
		translateX: ["-100%", "0"],
		opacity: ["0", "1"],
		duration: 1000,
		delay: stagger(200),
		autoplay: onScroll({
			container: "body",
			target: "#bio",
		}),
	});

	const tech = waapi.animate("#icons span", {
		translateY: ["100%", "0%"],
		opacity: ["0", "1"],
		duration: 1000,
		delay: stagger(200),
		autoplay: onScroll({
			container: "body",
			target: "#icons",
		}),
	});

	const button = waapi.animate("#currentTech", {
		transform: ["scale(.1)", "scale(1.025)", "scale(1)"],
		opacity: ["0", "1"],
		duration: 1000,
		autoplay: onScroll({
			container: "body",
			target: "#currentTech",
		}),
	});

	const cv = waapi.animate("#downloadCV", {
		transform: ["scale(.1)", "scale(1.025)", "scale(1)"],
		opacity: ["0", "1"],
		duration: 1000,
		autoplay: onScroll({
			container: "body",
			target: "#downloadCV",
		}),
	});

	const invitation = waapi.animate(["#invitation", "#invitation + span"], {
		transform: ["translateY(100%)", "translateY(0%)"],
		opacity: ["0", "1"],
		duration: 1000,
		delay: stagger(250),
		autoplay: onScroll({
			container: "body",
			target: "#invitation",
		}),
	});

	const links = document.querySelectorAll("[data-sm]");
	const currentTech = document.getElementById("currentTech");
	const downloadCV = document.getElementById("downloadCV");

	links.forEach((link) => {
		link.addEventListener("click", () => {
			const sm = link.getAttribute("data-sm") || "unknown";
			try {
				window.posthog?.capture("contact_social_clicked", {
					social_media: sm,
					location: "about_section",
				});
			} catch (err) {
				window.posthog?.captureException(err);
			}
		});
	});

	currentTech.addEventListener("click", () => {
		try {
			window.posthog?.capture("current_tech_clicked");
		} catch (err) {
			window.posthog?.captureException(err);
		}
	});

	downloadCV.addEventListener("click", () => {
		try {
			window.posthog?.capture("download_cv_clicked");
		} catch (err) {
			window.posthog?.captureException(err);
		}
	});
</script>
