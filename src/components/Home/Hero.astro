---
import Image from "astro/components/Image.astro";
import catedral from "../../assets/catedral.png";
---

<section
	id="hero"
	class="relative overflow-hidden w-full px-8 pb-4 pt-24 h-screen bg-ghost-white flex flex-col justify-start items-start"
>
	<div class="mb-8">
		<h1 class="text-8xl font-bold relative z-2 overflow-hidden pb-2">
			Hi, I'm Sergio
		</h1>
		<h2
			class="text-5xl lg:text-6xl lg:w-4/5 relative z-2 mix-blend-multiply"
		>
			I build <span class="text-indigo-ink font-bold mix-blend-multiply"
				>websites</span
			> and <span class="text-indigo-ink font-bold mix-blend-multiply"
				>web applications</span
			> that help <span
				class="text-indigo-ink font-bold mix-blend-multiply"
				>businesses grow</span
			>
		</h2>
	</div>
	<a
		id="work-together"
		href="#contact"
		class="relative cursor-pointer group z-2"
	>
		<div
			class="py-4 px-8 bg-indigo-ink text-ghost-white uppercase w-full h-full relative z-1 group-hover:bg-ghost-white group-hover:text-indigo-ink border border-indigo-ink transition"
		>
			let's work together
		</div>
		<div
			class="w-full h-full bg-ghost-white absolute top-1 -right-1 border border-indigo-ink group-hover:bg-indigo-ink transition"
		>
		</div>
	</a>
	<div
		id="church"
		class="absolute z-1 bottom-0 translate-y-24 lg:bottom-auto lg:translate-x-24"
	>
		<Image
			priority
			class="w-full h-full object-cover block"
			alt="Barinas' Main Cathedral"
			src={catedral}
		/>
	</div>
</section>

<script>
	import { waapi, stagger, splitText } from "animejs";

	const { chars } = splitText("#hero h1", { words: false, chars: true });

	const title = waapi.animate(chars, {
		translateY: ["100%", "0%"],
		duration: 1000,
		delay: stagger(50),
	});

	const subtitle = waapi.animate("#hero h2", {
		transform: ["scale(0.95)", "scale(1)"],
		opacity: [0, 1],
		duration: 750,
		delay: 250,
	});

	const button = waapi.animate("#work-together", {
		transform: ["scale(0.9)", "scale(1)"],
		opacity: [0, 1],
		duration: 500,
		delay: 500,
	});

	const church = waapi.animate("#church", {
		transform: ["scale(0.8)", "scale(1.01)", "scale(1)"],
		opacity: [0, 1],
		duration: 750,
		delay: 250,
	});

	const ctaButton = document.getElementById("work-together");
	ctaButton.addEventListener("click", () => {
		try {
			window.posthog?.capture("hero_cta_clicked");
		} catch (err) {
			window.posthog?.captureException(err);
		}
	});
</script>
