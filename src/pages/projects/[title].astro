---
import Layout from "../../layouts/Layout.astro";

const { title } = Astro.params;
---

<Layout>
	<h1>{title}</h1>
	<p>This is the project page for {title}.</p>
</Layout>

<script is:inline define:vars={{ projectTitle: Astro.params.title }}>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      window.posthog?.capture('project_viewed', { project_title: projectTitle });
    } catch (err) {
      window.posthog?.captureException(err);
    }
  });
</script>
