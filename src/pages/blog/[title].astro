---
import Layout from "../../layouts/Layout.astro";

const { title } = Astro.params;
---

<Layout>
	<h1>{title}</h1>
	<p>This is the blog post page for {title}.</p>
</Layout>

<script is:inline define:vars={{ postTitle: Astro.params.title }}>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      window.posthog?.capture('blog_post_viewed', { post_title: postTitle });
    } catch (err) {
      window.posthog?.captureException(err);
    }
  });
</script>
