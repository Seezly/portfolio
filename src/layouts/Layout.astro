---
import Footer from '../components/partials/Footer.astro';
import Header from '../components/partials/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="/src/styles/global.css">
		<title>Sergio Gutierrez - Web Developer</title>
	</head>
	<body class="bg-ghost-white text-ink-black-950 flex flex-col justify-center items-center w-full">
		<Header />
		<main class="flex flex-col justify-start items-start w-full overflow-x-hidden">
			<slot />
		</main>
		<Footer />
	</body>
</html>
